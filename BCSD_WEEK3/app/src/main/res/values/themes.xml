<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Bcsd_Week3_Assignment" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <!-- colorOnPrimary : 액션바 색상(버튼 글씨 색상 포함) -->
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="android:textColor">@color/my_gray</item>
    </style>
    <style name="my_button_style">
        <item name="android:backgroundTint">@color/my_gray</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="my_style" parent="my_style_textcolor">
        <!-- Customize style. -->
        <item name="android:background">@color/my_b_sky</item>
        <item name="colorOnPrimary">@color/my_b_purple</item>
    </style>
    <style name="my_style_textcolor">
        <!-- Customize style. -->
        <item name="android:textColor">@color/my_b_purple</item>
    </style>
</resources>