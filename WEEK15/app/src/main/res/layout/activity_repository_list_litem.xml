<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".ui.repositorylist.recyclerview.RepositoryListLitemActivity"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/item_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repo_item_title"
            android:textSize="20sp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">
        </TextView>

        <TextView
            android:id="@+id/item_detail_tv"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:text="@string/repo_item_detail"
            android:textSize="15sp"
            android:maxLines="2"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toBottomOf="@id/item_title_tv"
            app:layout_constraintStart_toStartOf="parent">
        </TextView>

        <ImageView
            android:id="@+id/item_icon_iv"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
        </ImageView>

        <ImageView
            android:id="@+id/item_star_iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toBottomOf="@id/item_detail_tv"
            app:layout_constraintStart_toStartOf="parent">
        </ImageView>

        <TextView
            android:id="@+id/item_star_tv"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="5dp"
            android:text="@string/repo_item_title"
            app:layout_constraintTop_toBottomOf="@id/item_detail_tv"
            app:layout_constraintStart_toEndOf="@+id/item_star_iv">
        </TextView>

        <ImageView
            android:id="@+id/item_fork_iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"
            app:layout_constraintTop_toBottomOf="@id/item_detail_tv"
            app:layout_constraintStart_toEndOf="@id/item_star_tv">
        </ImageView>

        <TextView
            android:id="@+id/item_fork_tv"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="5dp"
            android:text="@string/repo_item_title"
            app:layout_constraintTop_toBottomOf="@id/item_detail_tv"
            app:layout_constraintStart_toEndOf="@+id/item_fork_iv">
        </TextView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>