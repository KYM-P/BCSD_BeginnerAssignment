<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:theme="@style/myTextStyle">

    <TextView
        android:id="@+id/tv_main_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="150sp"
        android:layout_marginTop="150dp"
        style="@style/myTextStyle"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
    </TextView>
    <Button
        android:id="@+id/btn_dialog"
        android:layout_width="110dp"
        android:layout_height="50dp"
        android:text="Dialog"
        android:textSize="20sp"
        android:textAllCaps="false"
        android:background="@drawable/selector_button"
        android:layout_marginTop="500dp"
        android:layout_marginLeft="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:stateListAnimator="@null">
        <!-- 기본 버튼의 애니메이터를 제거한다 == fragment 의 위에 오지 않는다 -->
    </Button>

    <Button
        android:id="@+id/btn_count"
        android:layout_width="110dp"
        android:layout_height="50dp"
        android:text="Count"
        android:textSize="20sp"
        android:textAllCaps="false"
        android:background="@drawable/selector_button"
        android:layout_marginTop="500dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_random"
        app:layout_constraintStart_toEndOf="@+id/btn_dialog"
        app:layout_constraintTop_toTopOf="parent"
        android:stateListAnimator="@null">
    </Button>

    <Button
        android:id="@+id/btn_random"
        android:layout_width="110dp"
        android:layout_height="50dp"
        android:text="Random"
        android:textSize="20sp"
        android:textAllCaps="false"
        android:background="@drawable/selector_button"
        android:layout_marginTop="500dp"
        android:layout_marginRight="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:stateListAnimator="@null">
    </Button>

    <EditText
        android:id="@+id/et_toast"
        android:layout_width="150dp"
        android:layout_height="70dp"
        android:textSize="30sp"
        android:hint="mag"
        android:textColorHint="@color/my_b_gray"
        android:maxLength="5"
        android:textAlignment="center"
        android:drawableLeft="@drawable/vector_et"
        android:layout_marginTop="600dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
    </EditText>

    <FrameLayout
        android:id="@+id/fragment_show_random"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>