<?xml version="1.0" encoding="utf-8"?>
<!-- 상황에 따른 버튼 모양 지정 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@drawable/button_shape_selected"/>
    <item android:state_pressed="false" android:drawable="@drawable/button_shape"/>
    <!-- pressed: 누름 여부 / checked: 선택 여부 / enabled: 사용가능 여부 / focused: 포커스 여부 / selected: 선택 여부 -->
</selector>